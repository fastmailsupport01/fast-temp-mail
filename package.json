{
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "nodemailer": "^10.0.13",
    "postgres": "3.4.5",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.12",
    "@types/bun": "1.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "0.0.15",
    "drizzle-kit": "0.31.4",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "name": "fasttempmail",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "build": "bun ./client/build.mjs",
    "build:client": "bun ./client/build.mjs",
    "db:generate": "drizzle-kit generate --dialect=postgresql --schema=./server/src/schema.ts --out=./drizzle",
    "start": "bun ./server/src/index.ts",
    "test:smoke": "bun ./scripts/smoke-test.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module"
}