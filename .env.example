# Fast Temp Mail — environment template.
# Copy to `.env` for local runs. On Render/Railway, set these in the dashboard
# instead (never commit real values).

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Free Supabase PostgreSQL — no credit card. Supabase Dashboard → Project
# Settings → Database → Connection string → URI. Replace [YOUR-PASSWORD].
# Use the pooler URL (port 6543) for hosted apps like Render; the server
# disables prepared statements automatically for PgBouncer.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-REF.supabase.co:6543/postgres?pgbouncer=true&sslmode=require
# Set to "disable" only for a local Postgres without TLS:
# DATABASE_SSL=disable

# ── Admin account (created automatically on first boot) ───────────────────────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password-min-10-chars

# ── App ───────────────────────────────────────────────────────────────────────
# Display domain for generated temp addresses (e.g. word123@fasttempmail.site).
# Change this when you own a real domain — it does NOT receive real mail yet.
MAIL_DOMAIN=fasttempmail.site
# Demo helpers: "true" shows the "simulate incoming mail" button and reveals
# OTP codes on screen when email delivery is not configured. Set "false" for
# production.
DEMO_MODE=true
# Peppers stored session-token hashes. Generate once, e.g.:
#   bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
# Changing it later logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string
# Port the server listens on (hosts like Render set this themselves):
# PORT=3000

# ── Google OAuth (optional — enables "Continue with Google") ─────────────────
# GOOGLE_REDIRECT_URI must ALSO be registered in Google Cloud Console →
# your OAuth client → Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/oauth/callback
# Set to "true" to also request the Gmail read-only scope (needed later for
# the Pro "Gmail-connected mailbox" feature):
# GOOGLE_GMAIL_SCOPE=true

# ── Resend (optional — enables OTP + password-reset emails) ───────────────────
# Without this, signup is honest that codes cannot be delivered yet (in demo
# mode the code is shown on screen instead).
# RESEND_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Fast Temp Mail <noreply@mail.example.com>
